<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:pf="https://data-platform.local/ontology#"
         xml:base="https://data-platform.local/ontology">

  <owl:Ontology rdf:about="https://data-platform.local/ontology">
    <rdfs:label>Data platform ontology</rdfs:label>
    <rdfs:comment>Generated by `pf ontology export`. The knowledge graph is the
    source of truth; this file is a projection of it.</rdfs:comment>
    <owl:versionInfo>2</owl:versionInfo>
  </owl:Ontology>

  <!-- Classes -->
  <owl:Class rdf:about="https://data-platform.local/ontology#Party">
    <rdfs:label>Party</rdfs:label>
    <rdfs:comment>Any actor that can enter into an agreement.</rdfs:comment>
    <pf:abstract>true</pf:abstract>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Customer">
    <rdfs:label>Customer</rdfs:label>
    <rdfs:comment>A party that buys. May be a person or an organization.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://data-platform.local/ontology#Party"/>
    <pf:identity>customer_id</pf:identity>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Organization">
    <rdfs:label>Organization</rdfs:label>
    <rdfs:comment>A legal entity. Customers may belong to one.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://data-platform.local/ontology#Party"/>
    <pf:identity>organization_id</pf:identity>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Employee">
    <rdfs:label>Employee</rdfs:label>
    <rdfs:comment>Internal actor. Rarely modelled in marts; used for attribution.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://data-platform.local/ontology#Party"/>
    <pf:identity>employee_id</pf:identity>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Agreement">
    <rdfs:label>Agreement</rdfs:label>
    <rdfs:comment>A commitment between parties, with a lifecycle.</rdfs:comment>
    <pf:abstract>true</pf:abstract>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Subscription">
    <rdfs:label>Subscription</rdfs:label>
    <rdfs:comment>A recurring agreement with a plan, term and status.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://data-platform.local/ontology#Agreement"/>
    <pf:identity>subscription_id</pf:identity>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Order">
    <rdfs:label>Order</rdfs:label>
    <rdfs:comment>A one-off purchase commitment.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://data-platform.local/ontology#Agreement"/>
    <pf:identity>order_id</pf:identity>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Contract">
    <rdfs:label>Contract</rdfs:label>
    <rdfs:comment>A negotiated agreement, usually with custom terms.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://data-platform.local/ontology#Agreement"/>
    <pf:identity>contract_id</pf:identity>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Event">
    <rdfs:label>Event</rdfs:label>
    <rdfs:comment>Something that happened at a point in time. Immutable.</rdfs:comment>
    <pf:abstract>true</pf:abstract>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Payment">
    <rdfs:label>Payment</rdfs:label>
    <rdfs:comment>Movement of money settling an agreement.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://data-platform.local/ontology#Event"/>
    <pf:identity>payment_id</pf:identity>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Refund">
    <rdfs:label>Refund</rdfs:label>
    <rdfs:comment>Negative movement of money against a prior payment.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://data-platform.local/ontology#Event"/>
    <pf:identity>refund_id</pf:identity>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Usage">
    <rdfs:label>Usage</rdfs:label>
    <rdfs:comment>Metered consumption attributable to an agreement.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://data-platform.local/ontology#Event"/>
    <pf:identity>usage_id</pf:identity>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Interaction">
    <rdfs:label>Interaction</rdfs:label>
    <rdfs:comment>A touchpoint (email, call, session) with a party.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://data-platform.local/ontology#Event"/>
    <pf:identity>interaction_id</pf:identity>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Product">
    <rdfs:label>Product</rdfs:label>
    <rdfs:comment>A sellable thing. Plans and SKUs are Products.</rdfs:comment>
    <pf:identity>product_id</pf:identity>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Location">
    <rdfs:label>Location</rdfs:label>
    <rdfs:comment>A geography. Country, region, or address.</rdfs:comment>
    <pf:identity>location_id</pf:identity>
  </owl:Class>

  <owl:Class rdf:about="https://data-platform.local/ontology#Currency">
    <rdfs:label>Currency</rdfs:label>
    <rdfs:comment>An ISO 4217 currency. Qualifies every money amount.</rdfs:comment>
    <pf:identity>currency_code</pf:identity>
  </owl:Class>

