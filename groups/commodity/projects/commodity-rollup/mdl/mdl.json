      "name": "dim_markets_view",
      "statement": "select\n  dim_markets.market_code,\n  dim_markets.country_code,\n  dim_markets.currency_code,\n  dim_markets.is_reporting,\n  dim_markets.latest_price_date,\n  dim_markets.market_name,\n  dim_markets.home_exchange,\n  dim_markets.timezone,\n  dim_markets.project,\n  dim_markets.first_price_date,\n  dim_markets.commodities_priced,\n  dim_markets.landed_price_rows\nfrom dim_markets",
      "properties": {
        "pf.exposures": "report_market_comparison",
        "pf.exposure_types": "dashboard",
        "pf.owners": "data-platform",
        "pf.description": "Every market registered in the group's `markets` seed, with whether its sister is reporting and what the roll-up has received from it.",
        "pf.grain": "one market"
      }
    },
    {
      "name": "fct_landed_prices_daily_view",
      "statement": "select\n  fct_landed_prices_daily.landed_price_id,\n  fct_landed_prices_daily.market_code,\n  fct_landed_prices_daily.commodity_id,\n  fct_landed_prices_daily.price_date,\n  fct_landed_prices_daily.currency_code,\n  fct_landed_prices_daily.benchmark_price_usd,\n  fct_landed_prices_daily.usd_fx_rate,\n  fct_landed_prices_daily.landed_price_local,\n  fct_landed_prices_daily.landed_price_usd_per_quote_unit,\n  fct_landed_prices_daily.import_parity_premium_pct,\n  fct_landed_prices_daily.price_basis,\n  fct_landed_prices_daily.quote_unit,\n  fct_landed_prices_daily.market_unit,\n  fct_landed_prices_daily.fx_fixed_on,\n  fct_landed_prices_daily.effective_duty_rate,\n  fct_landed_prices_daily.is_import_prohibited,\n  fct_landed_prices_daily.is_duty_rate_confirmed,\n  dim_commodities.commodity_id as commodities_commodity_id,\n  dim_commodities.category,\n  dim_commodities.price_basis as commodities_price_basis,\n  dim_commodities.quote_unit as commodities_quote_unit,\n  dim_commodities.markets_pricing,\n  dim_commodities.commodity_name,\n  dim_commodities.segment,\n  dim_commodities.exchange,\n  dim_commodities.unit_dimension,\n  dim_markets.market_code as markets_market_code,\n  dim_markets.country_code,\n  dim_markets.currency_code as markets_currency_code,\n  dim_markets.is_reporting,\n  dim_markets.latest_price_date,\n  dim_markets.market_name,\n  dim_markets.home_exchange,\n  dim_markets.timezone,\n  dim_markets.project,\n  dim_markets.first_price_date,\n  dim_markets.commodities_priced,\n  dim_markets.landed_price_rows\nfrom fct_landed_prices_daily\n  left join dim_commodities on fct_landed_prices_daily.commodity_id = dim_commodities.commodity_id\n  left join dim_markets on fct_landed_prices_daily.market_code = dim_markets.market_code",
      "properties": {
        "pf.exposures": "report_index, report_metrics_avg_import_parity_ratio, report_metrics_avg_landed_price_usd, report_metrics_benchmark_usd_total_where_landed, report_metrics_landed_usd_days, report_metrics_landed_usd_total",
        "pf.exposure_types": "dashboard",
        "pf.owners": "data-platform",
        "pf.description": "Every market's daily landed price side by side: as the market reports it (its currency per its unit) and in USD per the benchmark's quote unit, with the import-parity premium each market adds over the benchmark. Prices are non-additive: aggregate within one commodity and one market.",
        "pf.grain": "one commodity per market per price date"
      }
    },
    {
      "name": "fct_market_spreads_daily_view",
      "statement": "select\n  fct_market_spreads_daily.landed_price_id,\n  fct_market_spreads_daily.market_code,\n  fct_market_spreads_daily.commodity_id,\n  fct_market_spreads_daily.price_date,\n  fct_market_spreads_daily.cheapest_market_code,\n  fct_market_spreads_daily.spread_to_cheapest_usd,\n  fct_market_spreads_daily.spread_to_cheapest_pct,\n  fct_market_spreads_daily.is_cheapest_market,\n  fct_market_spreads_daily.quote_unit,\n  fct_market_spreads_daily.markets_compared,\n  fct_market_spreads_daily.landed_price_usd_per_quote_unit,\n  fct_market_spreads_daily.cheapest_landed_usd,\n  dim_commodities.commodity_id as commodities_commodity_id,\n  dim_commodities.category,\n  dim_commodities.price_basis,\n  dim_commodities.quote_unit as commodities_quote_unit,\n  dim_commodities.markets_pricing,\n  dim_commodities.commodity_name,\n  dim_commodities.segment,\n  dim_commodities.exchange,\n  dim_commodities.unit_dimension,\n  dim_markets.market_code as markets_market_code,\n  dim_markets.country_code,\n  dim_markets.currency_code,\n  dim_markets.is_reporting,\n  dim_markets.latest_price_date,\n  dim_markets.market_name,\n  dim_markets.home_exchange,\n  dim_markets.timezone,\n  dim_markets.project,\n  dim_markets.first_price_date,\n  dim_markets.commodities_priced,\n  dim_markets.landed_price_rows,\n  dim_markets.country_code as markets_country_code,\n  dim_markets.currency_code as markets_currency_code,\n  dim_markets.is_reporting as markets_is_reporting,\n  dim_markets.latest_price_date as markets_latest_price_date,\n  dim_markets.market_name as markets_market_name,\n  dim_markets.home_exchange as markets_home_exchange,\n  dim_markets.timezone as markets_timezone,\n  dim_markets.project as markets_project,\n  dim_markets.first_price_date as markets_first_price_date,\n  dim_markets.commodities_priced as markets_commodities_priced,\n  dim_markets.landed_price_rows as markets_landed_price_rows\nfrom fct_market_spreads_daily\n  left join dim_commodities on fct_market_spreads_daily.commodity_id = dim_commodities.commodity_id\n  left join dim_markets on fct_market_spreads_daily.market_code = dim_markets.market_code\n  left join dim_markets on fct_market_spreads_daily.cheapest_market_code = dim_markets.market_code",
      "properties": {
        "pf.exposures": "report_index, report_metrics_avg_spread_to_cheapest_ratio, report_metrics_avg_spread_to_cheapest_usd, report_metrics_cheapest_usd_total, report_metrics_days_as_cheapest_market, report_metrics_spread_days, report_metrics_spread_usd_total",
        "pf.exposure_types": "dashboard",
        "pf.owners": "data-platform",
        "pf.description": "On days at least two markets priced a commodity: each market's landed price in USD per quote unit against the cheapest market's, as a spread and a percentage. Pure market effects \u2014 duty regimes and FX timing \u2014 because both sides stand on the same benchmark.",
        "pf.grain": "one commodity per market per price date"
      }
    },
    {
      "name": "rpt_market_comparison_board_view",
      "statement": "select\n  rpt_market_comparison_board.board_row_id,\n  rpt_market_comparison_board.market_code,\n  rpt_market_comparison_board.commodity_id,\n  rpt_market_comparison_board.category,\n  rpt_market_comparison_board.landed_price_usd_per_quote_unit,\n  rpt_market_comparison_board.spread_to_cheapest_pct,\n  rpt_market_comparison_board.is_stale,\n  rpt_market_comparison_board.market_name,\n  rpt_market_comparison_board.currency_code,\n  rpt_market_comparison_board.commodity_name,\n  rpt_market_comparison_board.segment,\n  rpt_market_comparison_board.price_date,\n  rpt_market_comparison_board.price_basis,\n  rpt_market_comparison_board.benchmark_price_usd,\n  rpt_market_comparison_board.quote_unit,\n  rpt_market_comparison_board.landed_price_local,\n  rpt_market_comparison_board.market_unit,\n  rpt_market_comparison_board.usd_fx_rate,\n  rpt_market_comparison_board.effective_duty_rate,\n  rpt_market_comparison_board.is_import_prohibited,\n  rpt_market_comparison_board.is_duty_rate_confirmed,\n  rpt_market_comparison_board.import_parity_premium_pct,\n  rpt_market_comparison_board.cheapest_market_code,\n  rpt_market_comparison_board.cheapest_landed_usd,\n  rpt_market_comparison_board.markets_compared,\n  rpt_market_comparison_board.is_cheapest_market,\n  rpt_market_comparison_board.price_age_days,\n  dim_commodities.commodity_id as commodities_commodity_id,\n  dim_commodities.category as commodities_category,\n  dim_commodities.price_basis as commodities_price_basis,\n  dim_commodities.quote_unit as commodities_quote_unit,\n  dim_commodities.markets_pricing,\n  dim_commodities.commodity_name as commodities_commodity_name,\n  dim_commodities.segment as commodities_segment,\n  dim_commodities.exchange,\n  dim_commodities.unit_dimension,\n  dim_markets.market_code as markets_market_code,\n  dim_markets.country_code,\n  dim_markets.currency_code as markets_currency_code,\n  dim_markets.is_reporting,\n  dim_markets.latest_price_date,\n  dim_markets.market_name as markets_market_name,\n  dim_markets.home_exchange,\n  dim_markets.timezone,\n  dim_markets.project,\n  dim_markets.first_price_date,\n  dim_markets.commodities_priced,\n  dim_markets.landed_price_rows\nfrom rpt_market_comparison_board\n  left join dim_commodities on rpt_market_comparison_board.commodity_id = dim_commodities.commodity_id\n  left join dim_markets on rpt_market_comparison_board.market_code = dim_markets.market_code",
      "properties": {
        "pf.exposures": "report_market_comparison",
        "pf.exposure_types": "dashboard",
        "pf.owners": "data-platform",
        "pf.description": "One row per commodity per market: the latest landed price on the benchmark's footing, the cheapest market to land it in, each market's spread to it, and how old each market's number is. The table behind the market comparison board.",
        "pf.grain": "one commodity per market"
      }
    }
  ],
  "cubes": [
    {
      "name": "commodity_rollup_core",
      "baseObject": "fct_market_spreads_daily",
      "measures": [
        {
          "name": "avg_import_parity_ratio",
          "expression": "sum(landed_price_usd_per_quote_unit) / nullif(sum(case when landed_price_usd_per_quote_unit is not null then benchmark_price_usd end), 0)",
          "type": "DOUBLE",
          "description": "Avg Import Parity Ratio",
          "properties": {
            "pf.metric_type": "ratio"
          }
        },
        {
          "name": "avg_landed_price_usd",
          "expression": "sum(landed_price_usd_per_quote_unit) / nullif(count(landed_price_usd_per_quote_unit), 0)",
          "type": "DOUBLE",
          "description": "Avg Landed Price (USD per quote unit)",
          "properties": {
            "pf.metric_type": "ratio"
          }
        },
        {
          "name": "avg_spread_to_cheapest_ratio",
          "expression": "sum(spread_to_cheapest_usd) / nullif(sum(cheapest_landed_usd), 0)",
          "type": "DOUBLE",
          "description": "Avg Spread to Cheapest Market (ratio)",
          "properties": {
            "pf.metric_type": "ratio"
          }
        },
        {
          "name": "avg_spread_to_cheapest_usd",
          "expression": "sum(spread_to_cheapest_usd) / nullif(count(spread_to_cheapest_usd), 0)",
          "type": "DOUBLE",
          "description": "Avg Spread to Cheapest Market (USD)",
          "properties": {
            "pf.metric_type": "ratio"
          }
        },
        {
          "name": "benchmark_usd_total_where_landed",
          "expression": "sum(case when landed_price_usd_per_quote_unit is not null then benchmark_price_usd end)",
          "type": "DOUBLE",
          "description": "Benchmark USD Total, landed days (component)",
          "properties": {
            "pf.metric_type": "simple"
          }
        },
        {
          "name": "cheapest_usd_total",
          "expression": "sum(cheapest_landed_usd)",
          "type": "DOUBLE",
          "description": "Cheapest Landed Total (component)",
          "properties": {
            "pf.metric_type": "simple"
          }
        },
        {
          "name": "days_as_cheapest_market",
          "expression": "sum(case when is_cheapest_market then 1 else 0 end)",
          "type": "DOUBLE",
          "description": "Days as Cheapest Market",
          "properties": {
            "pf.metric_type": "simple"
          }
        },
        {
          "name": "landed_usd_days",
          "expression": "count(landed_price_usd_per_quote_unit)",
          "type": "DOUBLE",
          "description": "Days With a Comparable Landed Price",
          "properties": {
            "pf.metric_type": "simple"
          }
        },
        {
          "name": "landed_usd_total",
          "expression": "sum(landed_price_usd_per_quote_unit)",
          "type": "DOUBLE",
          "description": "Landed USD Total (component)",
          "properties": {
            "pf.metric_type": "simple"
          }
        },
        {
          "name": "spread_days",
          "expression": "count(spread_to_cheapest_usd)",
          "type": "DOUBLE",
          "description": "Days Compared",
          "properties": {
            "pf.metric_type": "simple"
          }
        },
        {
          "name": "spread_usd_total",
          "expression": "sum(spread_to_cheapest_usd)",
          "type": "DOUBLE",
          "description": "Spread Total (component)",
          "properties": {
            "pf.metric_type": "simple"
          }
        }
      ],
