// Load the platform knowledge graph into Neo4j for Bloom.
//
// Generated by `pf bloom build` — do not edit. Regenerate instead, or the file
// will disagree with the graph it claims to describe.
//
// Put nodes.csv and edges.csv in the database's import/ directory, then run
// this whole script in Neo4j Browser or cypher-shell.

// One constraint, and it is what makes the load idempotent: re-running MERGEs
// onto the same nodes instead of doubling the graph.
CREATE CONSTRAINT kg_node_id IF NOT EXISTS
FOR (n:KgNode) REQUIRE n.id IS UNIQUE;

// ---- nodes ----------------------------------------------------------------
// A label per kind, plus :KgNode on everything so the constraint has one thing
// to hold and Bloom still sees fourteen categories.
LOAD CSV WITH HEADERS FROM 'file:///nodes.csv' AS row
CALL {
  WITH row
  MERGE (n:KgNode {id: row.`id:ID`})
  SET n.local_id = row.local_id,
      n.name     = row.name,
      n.layer    = row.layer,
      n.label    = row.label,
      n.group    = row.`group`,
      n.project  = row.project,
      n.plane    = row.plane,
      n.props    = row.props
  FOREACH (_ IN CASE WHEN row.`kind:LABEL` = 'Column' THEN [1] ELSE [] END |
    SET n:Column)
  FOREACH (_ IN CASE WHEN row.`kind:LABEL` = 'Concept' THEN [1] ELSE [] END |
    SET n:Concept)
  FOREACH (_ IN CASE WHEN row.`kind:LABEL` = 'Dimension' THEN [1] ELSE [] END |
    SET n:Dimension)
  FOREACH (_ IN CASE WHEN row.`kind:LABEL` = 'Evidence' THEN [1] ELSE [] END |
    SET n:Evidence)
  FOREACH (_ IN CASE WHEN row.`kind:LABEL` = 'Exposure' THEN [1] ELSE [] END |
    SET n:Exposure)
  FOREACH (_ IN CASE WHEN row.`kind:LABEL` = 'Metric' THEN [1] ELSE [] END |
    SET n:Metric)
  FOREACH (_ IN CASE WHEN row.`kind:LABEL` = 'Model' THEN [1] ELSE [] END |
    SET n:Model)
  FOREACH (_ IN CASE WHEN row.`kind:LABEL` = 'Policy' THEN [1] ELSE [] END |
    SET n:Policy)
  FOREACH (_ IN CASE WHEN row.`kind:LABEL` = 'Project' THEN [1] ELSE [] END |
    SET n:Project)
  FOREACH (_ IN CASE WHEN row.`kind:LABEL` = 'Property' THEN [1] ELSE [] END |
    SET n:Property)
  FOREACH (_ IN CASE WHEN row.`kind:LABEL` = 'Relation' THEN [1] ELSE [] END |
    SET n:Relation)
  FOREACH (_ IN CASE WHEN row.`kind:LABEL` = 'Source' THEN [1] ELSE [] END |
    SET n:Source)
  FOREACH (_ IN CASE WHEN row.`kind:LABEL` = 'Table' THEN [1] ELSE [] END |
    SET n:Table)
  FOREACH (_ IN CASE WHEN row.`kind:LABEL` = 'Test' THEN [1] ELSE [] END |
    SET n:Test)
} IN TRANSACTIONS OF 1000 ROWS;

// ---- relationships --------------------------------------------------------
// `apoc.merge.relationship` because the type is data, and Cypher cannot
// parameterise a relationship type. APOC ships with Aura and Desktop; if it is
// unavailable, split edges.csv by kind and write one MERGE per kind instead.
LOAD CSV WITH HEADERS FROM 'file:///edges.csv' AS row
CALL {
  WITH row
  MATCH (a:KgNode {id: row.`start:START_ID`})
  MATCH (b:KgNode {id: row.`end:END_ID`})
  CALL apoc.merge.relationship(a, row.`kind:TYPE`, {},
                               {props: row.props, kind: row.`kind:TYPE`}, b)
  YIELD rel
  RETURN count(rel) AS _
} IN TRANSACTIONS OF 1000 ROWS;

// ---- check ----------------------------------------------------------------
// Run this after loading. The numbers must match what `pf bloom build` printed;
// a short count means rows were rejected and the log will say which.
MATCH (n:KgNode) RETURN 'nodes' AS what, count(n) AS n
UNION ALL
MATCH ()-[r]->() RETURN 'edges' AS what, count(r) AS n;
