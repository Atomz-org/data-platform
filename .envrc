# direnv: keep every Claude Code session's working files inside this checkout.
#
# `direnv allow` once, and any `claude` started from this directory writes its
# scratchpad, background task output and pasted images under `.tmp/` instead of
# `/private/tmp/claude-<uid>/`. That is the same thing `bin/claude-here` does,
# without having to remember to type it.
#
# This lives here rather than in `.claude/settings.json` because the harness
# reads CLAUDE_CODE_TMPDIR when it starts, from the shell that launched it. A
# settings `env` block reaches the subprocesses it spawns afterwards, which is
# too late to decide where the session folder goes. See docs/CLAUDE-CODE.md.
#
# Inert without direnv installed, and safe to `direnv deny` -- the SessionStart
# hook still redirects the directories with symlinks, it just does it after the
# fact.
export CLAUDE_CODE_TMPDIR="$PWD/.tmp"
mkdir -p "$CLAUDE_CODE_TMPDIR"
