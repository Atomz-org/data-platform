ANTHROPIC_API_KEY=sk-ant-...
PF_WAREHOUSE=duckdb_local

# The artefact store — where recce baselines and recorded reviews live instead
# of in this repository. See docs/ARTIFACTS.md. An R2 API token scoped to
# Object Read & Write on the bucket; the endpoint and bucket have working
# defaults and only need setting for a fork or a second environment.
#
# Unset is a supported state: everything stays local, which is what you want on
# a machine that builds its own baseline. In CI it is not — a runner has no
# warehouse — so leaving these out there means "review not exercised".
PF_ARTIFACTS_ACCESS_KEY_ID=
PF_ARTIFACTS_SECRET_ACCESS_KEY=
# PF_ARTIFACTS_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# PF_ARTIFACTS_BUCKET=data-platform
