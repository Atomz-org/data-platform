{
  "mcpServers": {
    "ducklake": {
      "command": "uvx",
      "args": [
        "mcp-server-motherduck",
        "--db-path",
        "ducklake:${DUCKLAKE_METADATA}"
      ]
    },
    "wren": {
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "wren",
        "serve",
        "mcp",
        "--project",
        "mdl/wren",
        "--no-connect",
        "--quiet"
      ]
    }
  }
}
