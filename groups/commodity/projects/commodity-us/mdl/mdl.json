  "cubes": [
    {
      "name": "commodity_us_core",
      "baseObject": "fct_commodity_prices_daily",
      "measures": [
        {
          "name": "avg_benchmark_price_usd",
          "expression": "sum(close_price) / nullif(count(close_price), 0)",
          "type": "DOUBLE",
          "description": "Avg Benchmark Price (USD)",
          "properties": {
            "pf.metric_type": "ratio"
          }
        },
        {
          "name": "avg_duty_local",
          "expression": "sum(duty_local) / nullif(count(landed_price_local), 0)",
          "type": "DOUBLE",
          "description": "Avg Customs Duty (market currency)",
          "properties": {
            "pf.metric_type": "ratio"
          }
        },
        {
          "name": "avg_landed_price_local",
          "expression": "sum(landed_price_local) / nullif(count(landed_price_local), 0)",
          "type": "DOUBLE",
          "description": "Avg Landed Price (market currency)",
          "properties": {
            "pf.metric_type": "ratio"
          }
        },
        {
          "name": "avg_usd_fx_rate",
          "expression": "sum(usd_fx_rate) / nullif(count(landed_price_local), 0)",
          "type": "DOUBLE",
          "description": "Avg Applied FX Rate",
          "properties": {
            "pf.metric_type": "ratio"
          }
        },
        {
          "name": "benchmark_price_days",
          "expression": "count(close_price)",
          "type": "DOUBLE",
          "description": "Priced Days",
          "properties": {
            "pf.metric_type": "simple"
          }
        },
        {
          "name": "benchmark_price_usd_total",
          "expression": "sum(close_price)",
          "type": "DOUBLE",
          "description": "Benchmark Price Total (component)",
          "properties": {
            "pf.metric_type": "simple"
          }
        },
        {
          "name": "contracts_traded",
          "expression": "sum(volume)",
          "type": "DOUBLE",
          "description": "Contracts Traded",
          "properties": {
            "pf.metric_type": "simple"
          }
        },
        {
          "name": "duty_local_total",
          "expression": "sum(duty_local)",
          "type": "DOUBLE",
          "description": "Customs Duty Total (component)",
          "properties": {
            "pf.metric_type": "simple"
          }
        },
        {
          "name": "landed_price_days",
          "expression": "count(landed_price_local)",
          "type": "DOUBLE",
          "description": "Days With a Landed Price",
          "properties": {
            "pf.metric_type": "simple"
          }
        },
        {
          "name": "landed_price_local_total",
          "expression": "sum(landed_price_local)",
          "type": "DOUBLE",
          "description": "Landed Price Total (component)",
          "properties": {
            "pf.metric_type": "simple"
          }
        },
        {
          "name": "period_high_price_usd",
          "expression": "max(coalesce(high_price, close_price))",
          "type": "DOUBLE",
          "description": "Period High (USD)",
          "properties": {
            "pf.metric_type": "simple"
          }
        },
        {
          "name": "period_low_price_usd",
          "expression": "min(coalesce(low_price, close_price))",
          "type": "DOUBLE",
          "description": "Period Low (USD)",
          "properties": {
            "pf.metric_type": "simple"
          }
        },
        {
          "name": "usd_fx_rate_total",
          "expression": "sum(usd_fx_rate)",
          "type": "DOUBLE",
          "description": "Applied FX Rate Total (component)",
          "properties": {
            "pf.metric_type": "simple"
          }
        }
      ],
